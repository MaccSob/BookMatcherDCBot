# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token

# Gemini API key
GEMINI_API_KEY=your_gemini_api_key

# URL of the FastAPI service (local dev default shown; update if deployed)
API_URL=http://127.0.0.1:8000/recommend

# true = if you want to use mock_data.py instead of hitting Open Library (buggy)
USE_MOCK_DATA=false
